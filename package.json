{
  "name": "robustify",
  "private": true,
  "type": "module",
  "description": "ERP for printing presses: orders, production stages, inventory, purchasing and quality.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @robustify/api start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @robustify/api db:migrate",
    "db:deploy": "pnpm --filter @robustify/api db:deploy",
    "db:seed": "pnpm --filter @robustify/api db:seed",
    "db:reset": "pnpm --filter @robustify/api db:reset",
    "e2e": "pnpm --filter @robustify/e2e e2e"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
