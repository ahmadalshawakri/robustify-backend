# Copy to apps/api/.env for local development.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Matches docker-compose.yml
DATABASE_URL=postgresql://robustify:robustify@localhost:5432/robustify

# At least 32 characters. Generate one with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# Password given to every seeded demo account. Required in production.
SEED_PASSWORD=demo1234
