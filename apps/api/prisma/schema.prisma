// Robustify data model. Enum values mirror packages/shared/src/enums.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum Department {
  ADMINISTRATION
  DESIGN
  MONTAGE
  PRINTING
  CUTTING
  PACKAGING
  DELIVERY
}

enum OrderStatus {
  NOT_STARTED
  DESIGN
  MONTAGE
  PRINTING
  CUTTING
  PACKAGING
  IN_TRANSIT
  COMPLETED
}

enum ContactType {
  CUSTOMER
  SUPPLIER
}

enum PurchaseStatus {
  UPCOMING
  BOOKED
  PARTIAL
  CANCELED
}

enum ComplaintStatus {
  OPEN
  RESOLVED
}

enum QualityCostCategory {
  MAINTENANCE
  TRAINING
  EQUIPMENT
  INSPECTION
  DEFECT
  REWORK
  LOST_CUSTOMER
}

enum MaterialCategory {
  PAPER
  INK
  VARNISH
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  email        String     @unique
  passwordHash String
  role         Role
  department   Department
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions          Session[]
  assignedOrders    Order[]      @relation("OrderAssignee")
  orderEvents       OrderEvent[]
  complaintsHandled Complaint[]  @relation("ComplaintResponsible")
}

/// A signed-in browser. The cookie holds a random token; only its HMAC is stored.
model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A customer or a supplier. The same company can exist once per type.
model Contact {
  id        Int         @id @default(autoincrement())
  type      ContactType
  name      String
  email     String
  phone     String
  location  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  orders     Order[]
  purchases  Purchase[]
  complaints Complaint[]

  @@unique([email, type])
}

model Order {
  id          Int         @id @default(autoincrement())
  customerId  Int
  assigneeId  Int?
  /// Key from MATERIALS.PAPER.types
  paperType   String
  quantity    Int
  widthMm     Float
  heightMm    Float
  deadline    DateTime?
  /// Paper consumed by the job, in the same unit as the paper pack size
  consumption Int
  cost        Decimal     @db.Decimal(12, 2)
  status      OrderStatus @default(NOT_STARTED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customer   Contact      @relation(fields: [customerId], references: [id])
  assignee   User?        @relation("OrderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  events     OrderEvent[]
  invoice    Invoice?
  complaints Complaint[]

  @@index([status])
  @@index([assigneeId])
}

/// Audit trail of every stage change, which also drives utilization.
model OrderEvent {
  id         Int          @id @default(autoincrement())
  orderId    Int
  actorId    Int?
  fromStatus OrderStatus?
  toStatus   OrderStatus
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Purchase {
  id               Int              @id @default(autoincrement())
  supplierId       Int
  category         MaterialCategory
  /// Key from MATERIALS[category].types
  materialType     String
  /// Packs ordered and received so far
  quantity         Int
  quantityReceived Int              @default(0)
  cost             Decimal          @db.Decimal(12, 2)
  purchaseDate     DateTime         @db.Date
  expectedArrival  DateTime         @db.Date
  bookedAt         DateTime?
  status           PurchaseStatus   @default(UPCOMING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  supplier Contact @relation(fields: [supplierId], references: [id])

  @@index([status])
}

/// Current stock per material, in the material's unit (see MATERIALS).
/// Receiving a purchase adds to it; printing consumes paper.
model InventoryItem {
  id           Int              @id @default(autoincrement())
  category     MaterialCategory
  materialType String
  quantity     Int              @default(0)
  location     String?
  updatedAt    DateTime         @updatedAt

  @@unique([category, materialType])
}

model Complaint {
  id            Int             @id @default(autoincrement())
  orderId       Int
  customerId    Int
  responsibleId Int?
  defect        String
  comment       String?
  /// What fixing it cost (reprint, refund); counted as cost of poor quality
  cost          Decimal?        @db.Decimal(12, 2)
  status        ComplaintStatus @default(OPEN)
  resolvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer    Contact @relation(fields: [customerId], references: [id])
  responsible User?   @relation("ComplaintResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([responsibleId])
}

model Invoice {
  id       Int      @id @default(autoincrement())
  number   String   @unique
  orderId  Int      @unique
  subtotal Decimal  @db.Decimal(12, 2)
  tax      Decimal  @db.Decimal(12, 2)
  total    Decimal  @db.Decimal(12, 2)
  issuedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

/// Money spent on quality in a month, entered by an admin.
model QualityCost {
  id        Int                 @id @default(autoincrement())
  /// First day of the month it belongs to
  month     DateTime            @db.Date
  category  QualityCostCategory
  amount    Decimal             @db.Decimal(12, 2)
  note      String?
  createdAt DateTime            @default(now())

  @@index([month])
}
